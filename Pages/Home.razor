@page "/"

<span id="geolocation">
    <h2>Geolocation</h2>
    <div><b>Latitude</b>: <span>@Geolocation?.Latitude</span></div>
    <div><b>Latitude</b>: <span id="latitude"></span></div>
    <div><b>Longitude</b>: <span id="longitude"></span></div>
    <div><b>Accuracy</b>: <span id="accuracy"></span></div>
</span>

<br />

<span id="address">
    <h2>Address</h2>
    <div><b>ISO3166-2-LVL4</b>: <span id="ISO3166-2-lvl4"></span></div>
    <div><b>Tourism</b>: <span id="tourism"></span></div>
    <div><b>Suburb</b>: <span id="suburb"></span></div>
    <div><b>State</b>: <span id="state"></span></div>
    <div><b>Road</b>: <span id="road"></span></div>
    <div><b>Region</b>: <span id="region"></span></div>
    <div><b>Postcode</b>: <span id="postcode"></span></div>
    <div><b>Municipality</b>: <span id="municipality"></span></div>
    <div><b>County</b>: <span id="county"></span></div>
    <div><b>Country Code</b>: <span id="country_code"></span></div>
    <div><b>Country</b>: <span id="country"></span></div>
    <div><b>City</b>: <span id="city"></span></div>
</span>

<script type="text/javascript" src="js/geolocation.js"></script>